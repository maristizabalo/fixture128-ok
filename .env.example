# PIN del panel de resultados (/admin). Si no se define, es 951209.
ADMIN_PIN=951209

# Cualquier texto largo y aleatorio: firma los pases del panel.
AUTH_SECRET=cambia-esto-por-un-texto-largo

# Dónde se guardan los resultados en Vercel (gratis): un JSON en este mismo repo,
# rama datos-torneo. Token fine-grained con Contents: Read and write sobre el repo.
# En la computadora se deja vacío: los datos se guardan en .datos/
GITHUB_TOKEN=
# Opcionales: por defecto el repo desplegado en Vercel y la rama datos-torneo.
# GITHUB_REPO=maristizabalo/fixture128-ok
# GITHUB_RAMA=datos-torneo

# Alternativa: Redis de Upstash (se usa solo si no hay GITHUB_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Para tener varios torneos en el mismo Redis, cambia el prefijo.
FIXTURE_PREFIJO=fixture128
